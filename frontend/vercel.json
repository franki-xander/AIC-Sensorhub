{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/api/data", "destination": "/api/index.js?route=data" },
    { "source": "/api/pages", "destination": "/api/index.js?route=pages" }
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 30
    }
  }
}