# =============================================================================
# AIC Sensorhub v3 — Environment Variables
# For local development: copy to .env.local and fill in values.
# For production: set these in Vercel Dashboard → Project → Settings → Environment Variables
# NEVER commit .env.local to version control.
# =============================================================================

# PostgreSQL connection string from Supabase
# Settings → Database → Connection String → URI
# Replace [YOUR-PASSWORD] with your actual password
DATABASE_URL=

# JWT signing secret — generate with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Google OAuth 2.0 credentials
# Create at: https://console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=


# The full URL of the OAuth callback Vercel function
# Local dev:   http://localhost:3000/api/auth/callback
# Production:  https://yoursite.vercel.app/api/auth/callback
GOOGLE_CALLBACK_URL=https://yoursite.vercel.app/api/auth/callback

# Environment
NODE_ENV=production



